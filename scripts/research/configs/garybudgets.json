{
  "agent_id": "garybudgets-topics",
  "domain": "current film industry news: releases, casting, trailers, festivals, awards, deals, studio moves, and production news",
  "concurrency": 8,
  "paced_pause": 7,
  "window_days": 10,
  "max_topics": 10,
  "query_url_template": "https://news.google.com/rss/search?q={q}&hl=en-US&gl=US&ceid=US:en",

  "mix": {
    "finance": 0
  },

  "dedupe": {
    "corpus_url": "https://raw.githubusercontent.com/timothygaer/garybudgets-command-center/main/manifest.json",
    "corpus_files": ["manifest.json"]
  },

  "output": {
    "path": "topics.json",
    "history_file": "scripts/research/.history.json"
  },

  "delivery": {
    "telegram": true,
    "summary_max_topics": 5
  },

  "sources": [
    { "id": "variety", "name": "Variety", "category": "trade", "url": "https://variety.com/v/film/feed/" },
    { "id": "deadline", "name": "Deadline", "category": "trade", "url": "https://deadline.com/v/film/feed/" },
    { "id": "indiewire", "name": "IndieWire", "category": "trade", "url": "https://www.indiewire.com/feed/" },
    { "id": "thr", "name": "The Hollywood Reporter", "category": "trade", "url": "https://www.hollywoodreporter.com/feed/" },
    { "id": "screendaily", "name": "Screen Daily", "category": "trade", "url": "https://www.screendaily.com/45202.rss" },
    { "id": "thewrap", "name": "TheWrap", "category": "trade", "url": "https://www.thewrap.com/feed/" },
    { "id": "moviemaker", "name": "MovieMaker Magazine", "category": "trade", "url": "https://www.moviemaker.com/feed/" },
    { "id": "filmmaker", "name": "Filmmaker Magazine", "category": "trade", "url": "https://filmmakermagazine.com/feed/" },
    { "id": "nofilmschool", "name": "No Film School", "category": "tech", "url": "https://nofilmschool.com/feeds/content-types/article.rss" },
    { "id": "filmthreat", "name": "Film Threat", "category": "trade", "url": "https://filmthreat.com/feed/" },
    { "id": "worldofreel", "name": "World of Reel", "category": "trade", "url": "https://www.worldofreel.com/blog?format=rss" },
    { "id": "awardswatch", "name": "AwardsWatch", "category": "trade", "url": "https://awardswatch.com/feed/" },
    { "id": "cartoonbrew", "name": "Cartoon Brew", "category": "trade", "url": "https://www.cartoonbrew.com/feed" },

    { "id": "gn-filmnews", "name": "News: film industry news", "category": "trade", "query": "film industry news" },
    { "id": "gn-releases", "name": "News: movie releases", "category": "trade", "query": "new movie release" },
    { "id": "gn-trailer", "name": "News: film trailers", "category": "trade", "query": "movie trailer" },
    { "id": "gn-casting", "name": "News: film casting", "category": "trade", "query": "film casting news" },
    { "id": "gn-festival", "name": "News: film festivals", "category": "trade", "query": "film festival" },
    { "id": "gn-awards", "name": "News: film awards", "category": "trade", "query": "film awards" },
    { "id": "gn-animation", "name": "News: animation", "category": "trade", "query": "animated film" },
    { "id": "gn-documentary", "name": "News: documentary", "category": "trade", "query": "documentary film" },

    { "id": "filmla", "name": "FilmLA", "category": "finance", "url": "https://filmla.com/feed/" },
    { "id": "wrapbook", "name": "Wrapbook", "category": "finance", "url": "https://www.wrapbook.com/blog/rss.xml" },

    { "id": "sagaftra", "name": "SAG-AFTRA", "category": "guild", "url": "https://www.sagaftra.org/rss.xml" },

    { "id": "gn-tax", "name": "News: film tax incentive", "category": "finance", "query": "film tax incentive" },
    { "id": "gn-rebate", "name": "News: production rebate", "category": "finance", "query": "film production rebate" },
    { "id": "gn-indie-fin", "name": "News: indie film financing", "category": "finance", "query": "indie film financing" },
    { "id": "gn-prod-cost", "name": "News: production cost", "category": "finance", "query": "film production cost" },
    { "id": "gn-budget", "name": "News: film budget", "category": "finance", "query": "film budget" },
    { "id": "gn-insurance", "name": "News: production insurance", "category": "finance", "query": "film production insurance" },
    { "id": "gn-boxoffice", "name": "News: box office", "category": "box-office", "query": "box office" },
    { "id": "gn-guild", "name": "News: film crew union", "category": "guild", "query": "film crew union contract" },
    { "id": "gn-layoffs", "name": "News: film industry layoffs", "category": "finance", "query": "film industry layoffs" },
    { "id": "gn-ai", "name": "News: AI filmmaking", "category": "tech", "query": "AI filmmaking production" },
    { "id": "gn-streaming", "name": "News: streaming deals", "category": "finance", "query": "streaming film acquisition deal" },
    { "id": "gn-trending", "name": "News: film industry", "category": "trade", "query": "film industry" },

    { "id": "reddit-filmmakers", "name": "Reddit r/Filmmakers", "category": "social", "url": "https://www.reddit.com/r/Filmmakers/.rss", "paced": true },
    { "id": "reddit-indiefilm", "name": "Reddit r/indiefilm", "category": "social", "url": "https://www.reddit.com/r/indiefilm/.rss", "paced": true },
    { "id": "reddit-filmindustryla", "name": "Reddit r/FilmIndustryLA", "category": "social", "url": "https://www.reddit.com/r/FilmIndustryLA/.rss", "paced": true }
  ],

  "rubric": {
    "relevance_regex": "film|movie|cinema|box office|production|producer|filmmak|director|screen|festival|streaming|studio|theatr|distribut|indie|budget|crew|cast|post-production|post production|pre-production|pre production|guild|union|sag-aftra|iatse|wga|tax incentive|rebate|residual|insurance|payroll|financ|cinematograph|screenwrit|actor|actress|slate|sequel|franchise|release|premiere|award|trailer|documentary|animat|feature|miniseries|streamer",

    "finance_regex": "budget|cost|finance|financing|tax|incentive|rebate|payroll|insurance|bond|residual|distribution|box office|crew rate|union|guild|production accounting|cash flow|funding|grant|invoice|overage|gross|revenue|recoup",

    "priority_regex": "release|premiere|trailer|teaser|casting|\\bcast\\b|acquire|acquisition|\\bdeal\\b|greenlight|green-light|festival|award|\\bwins\\b|box office|opening weekend|\\brecord\\b|merger|merge|launch|announce|sequel|prequel|reboot|remake|streaming|distribution|\\brights\\b|slate|adaptation|\\bdirector\\b|signs on|\\btaps\\b|greenlit",

    "low_signal_regex": "wedding|dating|engaged|pregnant|\\bbaby\\b|horoscope|quiz|listicle|red carpet fashion|photos:|discount code|giveaway|\\bpresale\\b",

    "rework_regex": "major|new |change|rising|surge|strike|deal|law|policy|shutdown|hike|increase|rule|ruling|record|cut|collapse",

    "boost_terms": {
      "box office": 5,
      "trailer": 4,
      "premiere": 4,
      "festival": 5,
      "award": 4,
      "casting": 4,
      "deal": 4,
      "merger": 5,
      "acquisition": 4,
      "release": 3,
      "streaming": 3,
      "sequel": 4,
      "franchise": 4,
      "documentary": 4,
      "animation": 4,
      "director": 3,
      "indie": 4,
      "tax incentive": 4,
      "rebate": 3,
      "budget": 3,
      "cost": 3,
      "layoff": 4,
      "shutdown": 4,
      "union": 3,
      "AI ": 3
    },

    "source_weights": {
      "finance": 9,
      "guild": 8,
      "trade": 12,
      "box-office": 9,
      "tech": 6,
      "social": 2,
      "general": 1
    },

    "recency_points": 16,
    "trending_points": 7,
    "similar_threshold": 0.55,
    "duplicate_threshold": 0.62,
    "min_confidence": 60,
    "max_confidence": 96,
    "confidence_divisor": 150
  },

  "hooks": [
    ["trailer|teaser|first look", "First look: {title}"],
    ["casting|\\bcast\\b|to star|stars in|joins the", "Casting news: {title}"],
    ["festival|award|prize|\\bwins\\b|honou?r", "Festival & awards: {title}"],
    ["box office|opening weekend|grosses|grossing", "Box office: {title}"],
    ["acquire|acquisition|merger|merge|purchase|\\bsale\\b|sells|lands at", "Industry deal: {title}"],
    ["release date|will release|sets release|creates release|to release", "Release: {title}"],
    ["documentary|\\bdoc\\b", "Documentary: {title}"],
    ["animat|\\banime\\b|cartoon", "Animation: {title}"],
    ["layoff|shutdown|cutback|restructur", "Industry shake-up: {title}"],
    ["AI|artificial intelligence|virtual production|technology", "Tech & production: {title}"],
    ["budget|cost|tax incentive|rebate|insurance|payroll", "The business side: {title}"]
  ]
}
